<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %> - Kumix Stream
  </title>
  <link rel="icon" href="/images/kumix-logo.png" type="image/png">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <script src="/js/csrf.js"></script>
  <script src="/js/custom-dialog.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.30.0/fonts/tabler-icons.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.30.0/tabler-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/styles.css?v=2.0">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        fontFamily: {
          'inter': ['Inter', 'sans-serif'],
          'sans': ['Inter', 'system-ui', 'sans-serif']
        },
        extend: {
          colors: {
            'primary': '#E8102A',
            'secondary': '#C00D22',
            'dark': {
              '900': '#121212',
              '800': '#252525',
              '700': '#2D2D2D',
              '600': '#3D3D3D',
              '500': '#6E6E6E',
              '400': '#8F8F8F',
              '300': '#AFAFAF',
              '200': '#CFCFCF',
              '100': '#E5E5E5',
            },
            'gray': {
              '900': '#121212',
              '800': '#252525',
              '700': '#2D2D2D',
              '600': '#3D3D3D',
              '500': '#6E6E6E',
              '400': '#8F8F8F',
              '300': '#AFAFAF',
              '200': '#CFCFCF',
              '100': '#E5E5E5',
              '50': '#F5F5F5',
            }
          }
        }
      }
    }
  </script>
  <script src="/js/stream-modal.js" defer></script>
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then(function(registrations) {
        for (var r of registrations) r.unregister();
      });
      if ('caches' in window) {
        caches.keys().then(function(keys) {
          keys.forEach(function(k) { caches.delete(k); });
        });
      }
    }
  </script>
</head>
<body class="bg-dark-900 text-white font-inter">
  <div
    class="lg:hidden fixed top-0 left-0 right-0 h-16 bg-dark-800 shadow-lg flex items-center justify-between px-4 sm:px-6 z-30">
    <a href="/dashboard" class="flex items-center gap-2 min-w-0">
      <img src="/images/kumix-logo.png" alt="Kumix Stream Logo" class="h-8 shrink-0">
      <span class="text-lg font-bold tracking-tight truncate">Kumix <span class="text-primary">Stream</span></span>
    </a>
    <div class="flex items-center gap-1 shrink-0">
      <div id="mobile-server-time" class="hidden items-center gap-1.5 text-gray-400 text-sm mr-2">
        <span id="mobile-server-date">--</span>
        <span class="text-gray-600">•</span>
        <span id="mobile-server-clock" class="tabular-nums">--:--:--</span>
      </div>
      <div id="mobile-separator" class="hidden h-4 w-px bg-gray-600 mr-1"></div>
      <button id="sidebar-toggle" aria-label="Open menu"
        class="p-2 text-gray-300 hover:text-white rounded-lg transition-colors shrink-0">
        <i class="ti ti-menu-2 text-xl"></i>
      </button>
      <button id="mobile-profile-menu-button" title="<%= helpers.getUsername(req) %>"
        class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden ring-2 ring-gray-700 hover:ring-primary transition-all">
        <%- helpers.getAvatar(req) %>
      </button>
    </div>
  </div>
  <div id="sidebar-backdrop" class="lg:hidden fixed inset-0 bg-black/60 z-40 hidden"></div>
  <div class="flex">
    <div id="app-sidebar"
      class="fixed inset-y-0 left-0 z-50 flex flex-col w-60 h-screen bg-dark-800 shadow-lg overflow-hidden -translate-x-full transition-transform duration-200 ease-out lg:translate-x-0 lg:z-30">
      <a href="/dashboard" class="flex items-center gap-3 h-16 px-5 shrink-0 border-b border-dark-700">
        <img src="/images/kumix-logo.png" alt="Kumix Stream Logo" class="w-8 h-8 shrink-0">
        <span class="text-lg font-bold tracking-tight">Kumix <span class="text-primary">Stream</span></span>
      </a>
      <nav class="flex-1 overflow-y-auto px-3 pt-3 pb-4">
        <a href="/dashboard" class="sidebar-icon <%= active === 'dashboard' ? 'bg-primary' : '' %>">
          <i class="ti ti-broadcast text-xl"></i>
          <span>Streams</span>
        </a>
        <a href="/rotations" class="sidebar-icon <%= active === 'rotations' ? 'bg-primary' : '' %>">
          <i class="ti ti-rotate text-xl"></i>
          <span>Rotations</span>
        </a>
        <a href="/gallery" class="sidebar-icon <%= active === 'gallery' ? 'bg-primary' : '' %>">
          <i class="ti ti-video text-xl"></i>
          <span>Gallery</span>
        </a>
        <a href="/playlist" class="sidebar-icon <%= active === 'playlist' ? 'bg-primary' : '' %>">
          <i class="ti ti-playlist text-xl"></i>
          <span>Playlist</span>
        </a>
        <a href="/history" class="sidebar-icon <%= active === 'history' ? 'bg-primary' : '' %>">
          <i class="ti ti-history text-xl"></i>
          <span>History</span>
        </a>
        <% if (req.session && req.session.user_role === 'admin') { %>
        <a href="/users" class="sidebar-icon <%= active === 'users' ? 'bg-primary' : '' %>">
          <i class="ti ti-users text-xl"></i>
          <span>Users</span>
        </a>
        <% } %>
        <a href="/settings" class="sidebar-icon <%= active === 'settings' ? 'bg-primary' : '' %>">
          <i class="ti ti-settings text-xl"></i>
          <span>Settings</span>
        </a>
      </nav>
    </div>
    <div id="profile-dropdown" class="fixed bg-dark-800 shadow-xl border border-gray-700 hidden z-50">
      <div class="px-4 py-2 border-b border-gray-700">
        <div class="font-medium">
          <%= helpers.getUsername(req) %>
        </div>
      </div>
      <a href="/logout" class="flex items-center px-4 py-2.5 text-sm text-logout hover:bg-dark-700 transition-colors">
        <i class="ti ti-logout mr-3"></i>
        <span>Sign Out</span>
      </a>
    </div>
    <div class="min-w-0 w-full lg:ml-60 flex flex-col min-h-screen">
      <div
        class="hidden lg:fixed lg:flex top-0 right-0 left-60 items-center justify-end h-14 px-6 bg-dark-800 shadow-md z-10">
        <div id="server-time-display" class="flex items-center gap-1.5 text-gray-400 text-sm mr-4">
          <span id="server-date">--</span>
          <span class="text-gray-600">•</span>
          <span id="server-clock" class="tabular-nums">--:--:--</span>
        </div>
        <div class="h-4 w-px bg-gray-600 mr-4"></div>
        <button id="profile-menu-button" title="<%= helpers.getUsername(req) %>"
          class="w-9 h-9 rounded-full flex items-center justify-center overflow-hidden ring-2 ring-gray-700 hover:ring-primary transition-all">
          <%- helpers.getAvatar(req) %>
        </button>
      </div>
      <div class="p-6 pt-20 lg:pt-22 flex-1 min-w-0">
        <%- body %>
      </div>
    </div>
  </div>
</body>
</html>
<style>
  #server-clock, #mobile-server-clock {
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 550px) {
    #mobile-server-time {
      display: flex !important;
    }
    #mobile-separator {
      display: block !important;
    }
  }
  @media (min-width: 1024px) {
    #mobile-server-time {
      display: none !important;
    }
    #mobile-separator {
      display: none !important;
    }
  }
  #profile-dropdown {
    position: fixed;
    z-index: 100;
    min-width: 220px;
    border-radius: 8px;
    transition: all 0.2s ease;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    width: auto;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    top: 58px;
    right: 24px;
  }
  #profile-dropdown.hidden {
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    display: block !important;
    visibility: hidden;
  }
  .text-logout {
    color: #FF5555;
  }
  .text-logout:hover {
    color: #FF7777;
  }
  @media (max-width: 1023px) {
    body {
      padding-top: 16px;
    }
  }
  @media (max-width: 1023px) {
    #profile-dropdown {
      top: 66px;
    }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const profileButtons = ['profile-menu-button', 'mobile-profile-menu-button']
      .map(id => document.getElementById(id))
      .filter(Boolean);
    const profileDropdown = document.getElementById('profile-dropdown');
    if (profileButtons.length && profileDropdown) {
      profileButtons.forEach(button => button.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        profileDropdown.classList.toggle('hidden');
      }));
      document.addEventListener('click', (e) => {
        const insideDropdown = profileDropdown.contains(e.target);
        const onButton = profileButtons.some(button => button.contains(e.target));
        if (!insideDropdown && !onButton && !profileDropdown.classList.contains('hidden')) {
          profileDropdown.classList.add('hidden');
        }
      });
      profileDropdown.addEventListener('click', (e) => {
        e.stopPropagation();
      });
    }
    const sidebarToggle = document.getElementById('sidebar-toggle');
    const appSidebar = document.getElementById('app-sidebar');
    const sidebarBackdrop = document.getElementById('sidebar-backdrop');
    if (sidebarToggle && appSidebar && sidebarBackdrop) {
      const closeSidebar = () => {
        appSidebar.classList.remove('translate-x-0');
        sidebarBackdrop.classList.add('hidden');
      };
      sidebarToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = appSidebar.classList.toggle('translate-x-0');
        sidebarBackdrop.classList.toggle('hidden', !open);
      });
      sidebarBackdrop.addEventListener('click', closeSidebar);
      appSidebar.querySelectorAll('a[href]').forEach(link => link.addEventListener('click', closeSidebar));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSidebar();
      });
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    initServerTime();
  });

  let serverTimeOffset = 0;
  let serverTimezoneOffset = 0;
  let serverTimeInterval = null;

  async function initServerTime() {
    try {
      const response = await fetch('/api/server-time');
      if (!response.ok) return;
      const data = await response.json();
      const serverTime = new Date(data.serverTime);
      const clientTime = new Date();
      serverTimeOffset = serverTime.getTime() - clientTime.getTime();
      if (typeof data.timezoneOffset === 'number') {
        serverTimezoneOffset = data.timezoneOffset;
      }
      updateServerTimeDisplay();
      if (serverTimeInterval) clearInterval(serverTimeInterval);
      serverTimeInterval = setInterval(updateServerTimeDisplay, 1000);
      setInterval(syncServerTime, 5 * 60 * 1000);
    } catch (error) {
    }
  }

  async function syncServerTime() {
    try {
      const response = await fetch('/api/server-time');
      if (!response.ok) return;
      const data = await response.json();
      const serverTime = new Date(data.serverTime);
      const clientTime = new Date();
      serverTimeOffset = serverTime.getTime() - clientTime.getTime();
      if (typeof data.timezoneOffset === 'number') {
        serverTimezoneOffset = data.timezoneOffset;
      }
    } catch (error) {
    }
  }

  function updateServerTimeDisplay() {
    const serverNowMs = Date.now() + serverTimeOffset;
    const serverWallClock = new Date(serverNowMs - serverTimezoneOffset * 60 * 1000);
    const day = String(serverWallClock.getUTCDate()).padStart(2, '0');
    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const month = monthNames[serverWallClock.getUTCMonth()];
    const year = serverWallClock.getUTCFullYear();
    const hours = String(serverWallClock.getUTCHours()).padStart(2, '0');
    const minutes = String(serverWallClock.getUTCMinutes()).padStart(2, '0');
    const seconds = String(serverWallClock.getUTCSeconds()).padStart(2, '0');
    const dateStr = `${day} ${month} ${year}`;
    const timeStr = `${hours}:${minutes}:${seconds}`;
    const dateEl = document.getElementById('server-date');
    const clockEl = document.getElementById('server-clock');
    const mobileDateEl = document.getElementById('mobile-server-date');
    const mobileClockEl = document.getElementById('mobile-server-clock');
    if (dateEl) dateEl.textContent = dateStr;
    if (clockEl) clockEl.textContent = timeStr;
    if (mobileDateEl) mobileDateEl.textContent = dateStr;
    if (mobileClockEl) mobileClockEl.textContent = timeStr;
  }
</script>
